# Required only to download environments or mint an official ARC scorecard.
ARC_API_KEY=

# Required only when --backend openai-api is selected.
OPENAI_API_KEY=

# Required for the Claude Opus 5 model-parity lane (--backend anthropic-api).
ANTHROPIC_API_KEY=

# Optional cache location. The agent workspace is kept elsewhere.
ARDEA_AVO_ENVIRONMENTS_DIR=environment_files
